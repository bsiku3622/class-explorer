# /etc/class-explorer/ai.env  (chmod 600, owner baeks)
# 급식·ksain 목록 API 키 — 수집 타이머가 씁니다 (API 서비스의 Environment= 값과 같게)
KSAIN_API_KEY=
# 데스크탑 Ollama 게이트웨이 (WireGuard)
LLM_GATEWAY_URL=http://10.8.10.1:11434
LLM_LOCAL_MODEL=gemma4:12b
# OpenAI — 키를 넣으면 질문창 모델 목록에 OPENAI_MODELS 가 붙습니다
OPENAI_API_KEY=
OPENAI_MODELS=
# 용도별 기본 모델 (비우면 로컬). 예: openai:gpt-5-mini
AGENT_MODEL=
ANALYZE_MODEL=
