<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClassExplorer">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            위젯 둘. `exported="true"` 와 `APPWIDGET_UPDATE` 필터가 **둘 다** 있어야
            런처의 위젯 목록에 뜹니다 — 하나만 빠져도 조용히 안 보입니다.
        -->
        <receiver
            android:name=".widget.NowWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_now">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.MealWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_meal">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/meal_widget_info" />
        </receiver>
    </application>
</manifest>
