# 이 파일을 .env 로 복사해서 쓰세요 (.env 는 git 이 추적하지 않습니다)

# 백엔드 서버 주소.
# **class-explorer 와 같은 서버입니다** — 프론트만 둘이고 API 는 한 벌입니다.
# 배포 시: Netlify 대시보드 > Environment variables에서 설정
VITE_API_BASE_URL=https://classesapi.bsiku.dev

# 학교 구글 계정 로그인. 브라우저에 노출되는 공개 값이라 여기 둡니다
# (시크릿은 쓰지 않습니다 — ID 토큰만 받아 서버가 구글에 확인합니다)
VITE_GOOGLE_CLIENT_ID=1030075555154-icdnh0bjtsepdgf84mnbgecb37j1fct7.apps.googleusercontent.com
